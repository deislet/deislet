{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/deislet/provider-drivers/official-tool-lock.schema.json",
  "title": "Official provider automation tool source lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "observedAt", "tools"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "observedAt": {"type": "string", "format": "date-time"},
    "tools": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/tool"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider", "tool", "package", "version", "registry", "tarball",
        "npmIntegrity", "distributionSha256", "documentation",
        "serverAutomation"
      ],
      "properties": {
        "provider": {"enum": ["cloudflare-workers-pages", "tencent-edgeone-makers"]},
        "tool": {"type": "string", "minLength": 1},
        "package": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "registry": {"const": "https://registry.npmjs.org"},
        "tarball": {"type": "string", "format": "uri", "pattern": "^https://registry\\.npmjs\\.org/"},
        "npmIntegrity": {"type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"},
        "distributionSha256": {"$ref": "#/$defs/sha256"},
        "documentation": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "format": "uri", "pattern": "^https://"}
        },
        "serverAutomation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "credentialTransport", "credentialInArgv", "reason"],
          "properties": {
            "status": {"enum": ["candidate", "blocked"]},
            "credentialTransport": {
              "type": "array", "uniqueItems": true,
              "items": {"enum": ["stdin", "restricted-temporary-file", "system-keyring", "short-lived-environment"]}
            },
            "credentialInArgv": {"type": "boolean"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
