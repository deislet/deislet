{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/deislet/contracts/v1/canonical-artifact.schema.json",
  "$comment": "This is a Deislet control-plane record, not a second canonical output definition. The payload contract is the exact Edge Canon schemas/canonical-build-output.schema.json pinned by standards/edge-canon.lock.json.",
  "title": "Deislet canonical artifact control-plane record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "recordType", "artifactId", "applicationId", "state",
    "deployable", "createdAt", "canonicalOutput", "standard", "validation",
    "attestations", "signatures"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "recordType": {"const": "deislet.canonical-artifact-record/v1"},
    "artifactId": {"$ref": "#/$defs/canonicalId"},
    "applicationId": {"$ref": "#/$defs/canonicalId"},
    "state": {"enum": ["draft", "verified", "published"]},
    "deployable": {"type": "boolean"},
    "createdAt": {"type": "string", "format": "date-time"},
    "canonicalOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format", "manifestPath", "artifactSha256", "contentRootSha256",
        "fileCount", "storage"
      ],
      "properties": {
        "format": {"const": "edge-canon.build-output/v1"},
        "manifestPath": {"const": ".edge-canon/output.json"},
        "artifactSha256": {"$ref": "#/$defs/sha256"},
        "contentRootSha256": {"$ref": "#/$defs/sha256"},
        "fileCount": {"type": "integer", "minimum": 1},
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "locator"],
          "properties": {
            "kind": {"enum": ["directory", "object"]},
            "locator": {"type": "string", "minLength": 1, "maxLength": 2048}
          }
        }
      }
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId", "version", "releaseStatus", "sourceCommit",
        "contractDigest", "artifactSchemaPath", "artifactSchemaDigest"
      ],
      "properties": {
        "contractId": {"const": "edge-canon.next"},
        "version": {"type": "string", "pattern": "^edge-canon\\.next@[0-9a-f]{40}$"},
        "releaseStatus": {"enum": ["proposal", "candidate", "release-candidate", "standard"]},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "contractDigest": {"$ref": "#/$defs/digest"},
        "artifactSchemaPath": {"const": "schemas/canonical-build-output.schema.json"},
        "artifactSchemaDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "requirementsDigest", "reportPath", "reportDigest"],
      "properties": {
        "status": {"enum": ["pending", "passed", "failed"]},
        "requirementsDigest": {"$ref": "#/$defs/digest"},
        "reportPath": {"type": "string", "minLength": 1, "maxLength": 1024},
        "reportDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sbom", "provenance"],
      "properties": {
        "sbom": {"$ref": "#/$defs/documentReference"},
        "provenance": {"$ref": "#/$defs/documentReference"}
      }
    },
    "signatures": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "keyId", "algorithm", "value"],
        "properties": {
          "target": {"const": "canonical-manifest-sha256"},
          "keyId": {"type": "string", "minLength": 1},
          "algorithm": {"enum": ["ed25519", "ecdsa-p256-sha256"]},
          "value": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"enum": ["verified", "published"]}}, "required": ["state"]},
      "then": {"properties": {"validation": {"properties": {"status": {"const": "passed"}}}}}
    },
    {
      "if": {"properties": {"deployable": {"const": true}}, "required": ["deployable"]},
      "then": {
        "properties": {
          "state": {"const": "published"},
          "standard": {"properties": {"releaseStatus": {"const": "standard"}}},
          "validation": {"properties": {"status": {"const": "passed"}}},
          "signatures": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "canonicalId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"$ref": "#/$defs/sha256"}
      }
    },
    "documentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
