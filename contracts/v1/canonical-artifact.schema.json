{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/deislet/contracts/v1/canonical-artifact.schema.json",
  "title": "Canonical Edge Canon artifact record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "artifactFormat", "artifactId", "applicationId", "state",
    "deployable", "createdAt", "digest", "payload", "standard", "source",
    "inputs", "toolchain", "bindingInterfaceDigest", "sbom", "provenance",
    "validation", "signatures"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "artifactFormat": {"const": "edge-canon.canonical-artifact.v1"},
    "artifactId": {"$ref": "#/$defs/canonicalId"},
    "applicationId": {"$ref": "#/$defs/canonicalId"},
    "state": {"enum": ["draft", "verified", "published"]},
    "deployable": {"type": "boolean"},
    "createdAt": {"type": "string", "format": "date-time"},
    "digest": {"$ref": "#/$defs/digest"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["mediaType", "sizeBytes", "rootDigest"],
      "properties": {
        "mediaType": {"const": "application/vnd.edge-canon.artifact.v1+tar"},
        "sizeBytes": {"type": "integer", "minimum": 1},
        "rootDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "standard": {
      "type": "object", "additionalProperties": false,
      "required": ["contractId", "version", "releaseStatus", "sourceCommit", "contractDigest"],
      "properties": {
        "contractId": {"type": "string", "pattern": "^edge-canon\\.[a-z0-9.-]+$"},
        "version": {"type": "string", "minLength": 1},
        "releaseStatus": {"enum": ["proposal", "candidate", "release-candidate", "standard"]},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "contractDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "treeDigest", "dirty"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "minLength": 1},
        "treeDigest": {"$ref": "#/$defs/digest"},
        "dirty": {"const": false}
      }
    },
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["buildPlanDigest", "dependencyLockDigest", "publicBuildVariablesDigest"],
      "properties": {
        "buildPlanDigest": {"$ref": "#/$defs/digest"},
        "dependencyLockDigest": {"$ref": "#/$defs/digest"},
        "publicBuildVariablesDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "toolchain": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "version", "distributionDigest"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "distributionDigest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "bindingInterfaceDigest": {"$ref": "#/$defs/digest"},
    "sbom": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "digest"],
      "properties": {
        "format": {"enum": ["spdx-2.3", "cyclonedx-1.6"]},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "builderId", "digest"],
      "properties": {
        "format": {"const": "slsa-v1"},
        "builderId": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "requirementsDigest", "reportDigest"],
      "properties": {
        "status": {"enum": ["pending", "passed", "failed"]},
        "requirementsDigest": {"$ref": "#/$defs/digest"},
        "reportDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "signatures": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["keyId", "algorithm", "value"],
        "properties": {
          "keyId": {"type": "string", "minLength": 1},
          "algorithm": {"enum": ["ed25519", "ecdsa-p256-sha256"]},
          "value": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"deployable": {"const": true}}, "required": ["deployable"]},
      "then": {
        "properties": {
          "state": {"const": "published"},
          "standard": {"properties": {"releaseStatus": {"const": "standard"}}},
          "validation": {"properties": {"status": {"const": "passed"}}},
          "signatures": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "canonicalId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
