  },
  "supportedStandardVersions": [],
  "operations": ["preflight", "plan", "prepare", "upload", "verify", "activate", "observe", "rollback", "inspect", "reconcile", "delete", "cleanup"],
  "officialTools": [
    {
      "kind": "cli",
      "name": "wrangler",
