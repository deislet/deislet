{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/deislet/contracts/v1/control-error.schema.json",
  "title": "Deislet Control error envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "requestId", "violations", "retryable"],
      "properties": {
        "code": {
          "description": "Stable machine-readable failure class. Clients branch on this and never on the message text. The set is closed; a new class is a contract change.",
          "enum": [
            "not-found",
            "invalid-argument",
            "limit-out-of-range",
            "cursor-invalid",
            "idempotency-key-required",
            "idempotency-key-reused",
            "idempotency-request-in-progress",
            "precondition-required",
            "revision-conflict",
            "already-exists",
            "conflict",
            "not-configured",
            "forbidden",
            "insufficient-scope",
            "unauthenticated",
            "payload-too-large",
            "service-unavailable",
            "backend-unavailable",
            "database-unavailable",
            "internal",
            "route-not-found",
            "provider-installation-has-dependents",
            "provider-installation-in-use",
            "provider-target-in-use",
            "provider-resource-deleted",
            "operation-not-cancellable",
            "operation-not-rollbackable"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Human-readable explanation for an operator. It is not stable, is never parsed, and MUST NOT contain credentials, tokens, ciphertext or secret values."
        },
        "requestId": {
          "$ref": "#/$defs/canonicalId",
          "description": "The Control request correlation ID also returned in the response headers and written to the server log for the same request."
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource"],
          "properties": {
            "resource": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 64,
              "description": "Kind of the resource the failure is about, not its canonical ID."
            },
            "field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Request member the failure is about, in dotted path form for bodies and in bare name form for query and header parameters."
            }
          }
        },
        "violations": {
          "type": "array",
          "maxItems": 100,
          "description": "Per-field detail for a request that failed validation. Always present; empty unless the failure decomposes into named members, in which case a single global failure still uses target instead.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "code", "message"],
            "properties": {
              "field": {"type": "string", "minLength": 1, "maxLength": 256},
              "code": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 64,
                "description": "Field-level failure class. Finer grained than the envelope code and scoped to the field, never a second spelling of it."
              },
              "message": {"type": "string", "minLength": 1, "maxLength": 1024}
            }
          }
        },
        "retryable": {
          "type": "boolean",
          "description": "Whether an identical request may succeed later without any change by the caller. It is a property of the code, not of the individual request."
        },
        "retryAfterSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400,
          "description": "Server-advised wait before the retry, mirroring the Retry-After header. Only meaningful when retryable is true; absence means the client picks its own backoff."
        },
        "docs": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048,
          "description": "Absolute HTTPS link to the documentation for this failure class."
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backendId"],
          "description": "Provider-side diagnostic passed through from a driver outcome. It reuses the provider-driver-process error vocabulary verbatim and never carries provider management credentials.",
          "properties": {
            "backendId": {
              "enum": ["deislet", "cloudflare-workers-pages", "tencent-edgeone-makers", "deno"]
            },
            "category": {
              "enum": [
                "authentication", "permission", "quota", "configuration", "build",
                "upload", "resource", "verification", "activation",
                "transient-provider", "unknown-state", "driver-integrity", "internal"
              ]
            },
            "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"},
            "sideEffect": {"enum": ["none", "possible", "confirmed"]},
            "requestId": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        }
      }
    }
  },
  "$defs": {
    "canonicalId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
