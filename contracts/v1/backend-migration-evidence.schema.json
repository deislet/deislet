{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/deislet/contracts/v1/backend-migration-evidence.schema.json",
  "title": "Backend tenant inventory under a durable writer fence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "backend", "tenant", "authenticationDomain", "fence",
    "components", "capturedAt"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "backend": {"type": "string", "minLength": 1, "maxLength": 128},
    "tenant": {"type": "string", "minLength": 1, "maxLength": 256},
    "authenticationDomain": {"const": "migration-admin"},
    "fence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migrationId", "expectedApplicationRevision", "epoch", "acquiredAt",
        "receiptDigest"
      ],
      "properties": {
        "migrationId": {"$ref": "#/$defs/canonicalId"},
        "expectedApplicationRevision": {"type": "integer", "minimum": 1},
        "epoch": {"type": "integer", "minimum": 1},
        "acquiredAt": {"type": "string", "format": "date-time"},
        "receiptDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component", "itemCount", "logicalBytes", "digest", "orphanCount",
          "uncheckedOrphanCount"
        ],
        "properties": {
          "component": {
            "enum": [
              "kv", "sql", "blob", "queue", "telemetry", "stateful-objects",
              "provider-resources"
            ]
          },
          "itemCount": {"type": "integer", "minimum": 0},
          "logicalBytes": {"type": "integer", "minimum": 0},
          "digest": {"$ref": "#/$defs/digest"},
          "orphanCount": {"type": "integer", "minimum": 0},
          "uncheckedOrphanCount": {"type": "integer", "minimum": 0}
        }
      }
    },
    "capturedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "canonicalId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
