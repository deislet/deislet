{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/deislet/contracts/v1/provider-driver-release.schema.json",
  "title": "Cross-platform provider driver release index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "driverContractVersion",
    "driver",
    "distributions",
    "installationPolicy"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "driverContractVersion": {"type": "string", "pattern": "^1\\.0\\.0(?:-draft\\.[0-9]+)?$"},
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}
      }
    },
    "distributions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/distribution"}
    },
    "installationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archiveFormat",
        "allowLinks",
        "allowNonRegularFiles",
        "allowExtraFiles",
        "contentAddressed",
        "readOnlyAfterInstall",
        "verifyBeforeEveryExecution"
      ],
      "properties": {
        "archiveFormat": {"const": "tar"},
        "allowLinks": {"const": false},
        "allowNonRegularFiles": {"const": false},
        "allowExtraFiles": {"const": false},
        "contentAddressed": {"const": true},
        "readOnlyAfterInstall": {"const": true},
        "verifyBeforeEveryExecution": {"const": true}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9._@+~-]+(?:/[A-Za-z0-9._@+~-]+)*$",
      "not": {"pattern": "(^|/)\\.\\.?(/|$)"}
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes", "executable"],
      "properties": {
        "path": {"$ref": "#/$defs/portablePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "sizeBytes": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "executable": {"type": "boolean"}
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "argumentPrefix"],
      "properties": {
        "path": {"$ref": "#/$defs/portablePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "argumentPrefix": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "maxLength": 4096, "pattern": "^[^\\u0000]*$"}
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "name", "version", "implementation", "materializationDigest"],
      "properties": {
        "role": {"enum": ["driver", "official-tool"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 200},
        "toolKind": {"enum": ["cli", "api", "sdk", "native"]},
        "implementation": {"enum": ["builtin", "executable"]},
        "materializationDigest": {"$ref": "#/$defs/sha256"},
        "sourceDistributionDigest": {"$ref": "#/$defs/sha256"},
        "filePaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/portablePath"}
        },
        "executable": {"$ref": "#/$defs/executable"}
      },
      "allOf": [
        {
          "if": {"properties": {"role": {"const": "official-tool"}}, "required": ["role"]},
          "then": {"required": ["toolKind", "sourceDistributionDigest"]},
          "else": {
            "not": {
              "anyOf": [
                {"required": ["toolKind"]},
                {"required": ["sourceDistributionDigest"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"implementation": {"const": "executable"}}, "required": ["implementation"]},
          "then": {"required": ["filePaths", "executable"]},
          "else": {
            "not": {
              "anyOf": [
                {"required": ["filePaths"]},
                {"required": ["executable"]}
              ]
            }
          }
        }
      ]
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostOperatingSystem",
        "archive",
        "treeDigest",
        "components",
        "files"
      ],
      "properties": {
        "hostOperatingSystem": {"enum": ["linux-amd64", "linux-arm64", "macos-arm64", "windows-amd64"]},
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "sha256", "sizeBytes"],
          "properties": {
            "format": {"const": "tar"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 4294967296}
          }
        },
        "treeDigest": {"$ref": "#/$defs/sha256"},
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/component"}
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/file"}
        }
      }
    }
  }
}
