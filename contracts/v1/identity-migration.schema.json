{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/deislet/contracts/v1/identity-migration.schema.json",
  "title": "Legacy name-based identity migration record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "migrationId", "operationId", "state", "legacyApplicationName",
    "canonicalApplicationId", "environments", "phases", "fence", "verification",
    "legacyCapabilitiesRevoked", "nameTombstoneRetained", "createdAt", "updatedAt"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "migrationId": {"$ref": "#/$defs/canonicalId"},
    "operationId": {"$ref": "#/$defs/canonicalId"},
    "state": {"enum": ["planned", "running", "waiting", "verified", "cutover", "completed", "failed"]},
    "legacyApplicationName": {"type": "string", "minLength": 1, "maxLength": 64},
    "canonicalApplicationId": {"$ref": "#/$defs/canonicalId"},
    "environments": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["legacyName", "legacyTenantKey", "canonicalEnvironmentId", "canonicalTenantKey", "bindingMappings"],
        "properties": {
          "legacyName": {"type": "string", "minLength": 1, "maxLength": 64},
          "legacyTenantKey": {"type": "string", "minLength": 3, "maxLength": 194},
          "canonicalEnvironmentId": {"$ref": "#/$defs/canonicalId"},
          "canonicalTenantKey": {"type": "string", "pattern": "^v1/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
          "bindingMappings": {
            "type": "array", "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["legacyName", "bindingId"],
              "properties": {
                "legacyName": {"type": "string", "minLength": 1},
                "bindingId": {"$ref": "#/$defs/canonicalId"}
              }
            }
          }
        }
      }
    },
    "phases": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "state", "attempt", "startedAt", "finishedAt", "errorCode"],
        "properties": {
          "name": {"enum": ["inventory", "allocate-canonical-ids", "dual-read", "copy-or-rename", "verify", "cutover", "revoke-legacy-capabilities", "tombstone"]},
          "state": {"enum": ["pending", "running", "succeeded", "failed"]},
          "attempt": {"type": "integer", "minimum": 0},
          "startedAt": {"type": ["string", "null"], "format": "date-time"},
          "finishedAt": {"type": ["string", "null"], "format": "date-time"},
          "errorCode": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]+$"}
        }
      }
    },
    "fence": {
      "type": "object", "additionalProperties": false,
      "required": ["expectedApplicationRevision", "token"],
      "properties": {
        "expectedApplicationRevision": {"type": "integer", "minimum": 1},
        "token": {"type": "string", "minLength": 32}
      }
    },
    "verification": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component", "sourceCount", "targetCount", "sourceDigest", "targetDigest", "outcome"],
        "properties": {
          "component": {"enum": ["catalog", "kv", "sql", "blob", "queue", "telemetry", "stateful-objects", "provider-resources"]},
          "sourceCount": {"type": "integer", "minimum": 0},
          "targetCount": {"type": "integer", "minimum": 0},
          "sourceDigest": {"$ref": "#/$defs/digest"},
          "targetDigest": {"$ref": "#/$defs/digest"},
          "outcome": {"enum": ["pending", "match", "mismatch", "not-applicable"]}
        }
      }
    },
    "legacyCapabilitiesRevoked": {"type": "boolean"},
    "nameTombstoneRetained": {"const": true},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"properties": {"phases": {"contains": {"properties": {"name": {"const": "inventory"}}, "required": ["name"]}}}},
    {"properties": {"phases": {"contains": {"properties": {"name": {"const": "allocate-canonical-ids"}}, "required": ["name"]}}}},
    {"properties": {"phases": {"contains": {"properties": {"name": {"const": "dual-read"}}, "required": ["name"]}}}},
    {"properties": {"phases": {"contains": {"properties": {"name": {"const": "copy-or-rename"}}, "required": ["name"]}}}},
    {"properties": {"phases": {"contains": {"properties": {"name": {"const": "verify"}}, "required": ["name"]}}}},
    {"properties": {"phases": {"contains": {"properties": {"name": {"const": "cutover"}}, "required": ["name"]}}}},
    {"properties": {"phases": {"contains": {"properties": {"name": {"const": "revoke-legacy-capabilities"}}, "required": ["name"]}}}},
    {"properties": {"phases": {"contains": {"properties": {"name": {"const": "tombstone"}}, "required": ["name"]}}}},
    {
      "if": {"properties": {"state": {"const": "completed"}}, "required": ["state"]},
      "then": {
        "properties": {
          "legacyCapabilitiesRevoked": {"const": true},
          "phases": {"items": {"properties": {"state": {"const": "succeeded"}}}},
          "verification": {"items": {"properties": {"outcome": {"enum": ["match", "not-applicable"]}}}}
        }
      }
    }
  ],
  "$defs": {
    "canonicalId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {"algorithm": {"const": "sha256"}, "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }
  }
}
