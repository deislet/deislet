{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/deislet/contracts/v1/provider-driver-transparency-proof.schema.json",
  "title": "Offline provider driver authorization transparency proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "mediaType", "authorizationSha256", "entries"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1, "maxLength": 256},
    "schemaVersion": {"const": 1},
    "mediaType": {
      "const": "application/vnd.deislet.provider-driver-transparency-proof.v1+json"
    },
    "authorizationSha256": {"$ref": "#/$defs/digest"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "noteName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[!-*,-~]+$"
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logOrigin", "logIndex", "inclusionPath", "checkpoint"],
      "properties": {
        "logOrigin": {"$ref": "#/$defs/noteName"},
        "logIndex": {"type": "integer", "minimum": 0},
        "inclusionPath": {
          "type": "array",
          "maxItems": 64,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"}
        },
        "checkpoint": {"type": "string", "minLength": 1, "maxLength": 65536}
      }
    }
  }
}
