{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/deislet/contracts/v1/provider-driver-trust-root.schema.json",
  "title": "Provider driver release trust root",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "rootVersion", "expiresAt",
    "providerDriverRelease", "keys"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": 1},
    "rootVersion": {"type": "integer", "minimum": 1},
    "expiresAt": {"type": "string", "format": "date-time"},
    "providerDriverRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyIds", "threshold", "maxAuthorizationLifetimeSeconds"],
      "properties": {
        "keyIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/keyId"}
        },
        "threshold": {"type": "integer", "minimum": 1, "maximum": 32},
        "maxAuthorizationLifetimeSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        }
      }
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/key"}
    }
  },
  "$defs": {
    "keyId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId", "keyType", "scheme", "publicKey", "status",
        "validFrom", "validUntil"
      ],
      "properties": {
        "keyId": {"$ref": "#/$defs/keyId"},
        "keyType": {"const": "ed25519"},
        "scheme": {"const": "ed25519"},
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "status": {"enum": ["active", "revoked"]},
        "validFrom": {"type": "string", "format": "date-time"},
        "validUntil": {"type": "string", "format": "date-time"},
        "revokedAt": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "revoked"}}, "required": ["status"]},
          "then": {"required": ["revokedAt"]},
          "else": {"not": {"required": ["revokedAt"]}}
        }
      ]
    }
  }
}
