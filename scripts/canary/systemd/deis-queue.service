[Unit]
Description=Deislet queue
Documentation=https://github.com/deislet/deislet
After=network-online.target
Wants=network-online.target
PartOf=deislet.target

[Service]
Type=simple
User=deis
Group=deis
WorkingDirectory=/var/lib/deis/queue
ExecStart=/usr/local/bin/deis-queue -c /etc/deis/queue.toml
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
LimitNOFILE=65536
Environment=RUST_LOG=info
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deis-queue
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Slice=deislet.slice
MemoryMax=512M
ReadWritePaths=/var/lib/deis/queue

[Install]
WantedBy=deislet.target
