[Unit]
Description=Deislet telemetry (logs, traces, metrics)
Documentation=https://github.com/deislet/deislet
After=network-online.target
Wants=network-online.target
PartOf=deislet.target

[Service]
Type=simple
User=deis
Group=deis
WorkingDirectory=/var/lib/deis/telemetry
ExecStart=/usr/local/bin/deis-telemetry -c /etc/deis/telemetry.toml
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
LimitNOFILE=65536
Environment=RUST_LOG=info
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deis-telemetry
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/deis/telemetry

[Install]
WantedBy=deislet.target
