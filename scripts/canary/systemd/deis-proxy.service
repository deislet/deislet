[Unit]
Description=Deislet edge proxy
Documentation=https://github.com/deislet/deislet
After=network-online.target deis-control.service deis-runtime.service
Wants=network-online.target deis-control.service deis-runtime.service
PartOf=deislet.target

[Service]
Type=simple
User=deis
Group=deis
WorkingDirectory=/var/lib/deis/proxy
ExecStart=/usr/local/bin/deis-proxy -c /etc/deis/proxy.toml
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
LimitNOFILE=65536
Environment=RUST_LOG=info
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deis-proxy
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/deis/proxy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=deislet.target
