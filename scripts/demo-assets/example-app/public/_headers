# Every response this site serves out of a file.
/*
  Referrer-Policy: strict-origin-when-cross-origin

# The stylesheet only ever changes when the version does, and a version is a
# whole new bundle, so a year is safe. This is the block that overrides the
# node's own default for an asset, which is "ask me again every time" because
# a bundle path is not content-addressed.
/css/*
  Cache-Control: public, max-age=31536000, immutable
