{
  "version": "1.0.0",
  "name": "demo",
  "runtime": "standard-v1",
  "language": "typescript",
  "functionRoot": "./functions",
  "compatibilityDate": "2026-09-01",
  "environment": {
    "variables": {
      "BUILD_LABEL": "v1",
      "LOG_LEVEL": "info",
      "ASSETS": "an-application-cannot-take-this-name"
    },
    "secrets": [
      "DEMO_SECRET"
    ]
  },
  "bindings": {
    "KV": {
      "kind": "kv"
    },
    "jobs": {
      "kind": "queue"
    },
    "HOT": {
      "kind": "kv"
    },
    "COLD": {
      "kind": "kv"
    },
    "AUTH": {
      "kind": "service",
      "app": "demo-auth"
    }
  },
  "queues": [
    {
      "name": "jobs",
      "batchSize": 10,
      "maxConcurrency": 2
    }
  ],
  "cron": [
    "* * * * *"
  ],
  "limits": {
    "timeoutMs": 1000,
    "memoryMb": 32,
    "maxSubrequests": 6
  },
  "assets": {
    "dir": "./public",
    "notFound": "404-page"
  },
  "vendors": {
    "deislet": {
      "enabled": true
    }
  },
  "build": {
    "outDir": "./dist"
  }
}
