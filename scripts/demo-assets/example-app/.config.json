{
  "version": "1.0.0",
  "name": "demo",
  "runtime": "standard-v1",
  "language": "typescript",
  "functionRoot": "./functions",
  "compatibilityDate": "2026-09-01",
  "environment": {
    "variables": {
      "BUILD_LABEL": "v1",
      "LOG_LEVEL": "info",
      "ASSETS": "an-application-cannot-take-this-name"
    },
    "secrets": ["DEMO_SECRET"]
  },
  "services": {
    "kv": { "enabled": true },
    "queue": { "enabled": true }
  },
  "queues": [{ "name": "jobs", "batchSize": 10 }],
  "cron": ["* * * * *"],
  "limits": {
    "timeoutMs": 1000,
    "memoryMb": 32
  },
  "assets": {
    "dir": "./public",
    "notFound": "404-page"
  },
  "vendors": {
    "deislet": { "enabled": true }
  },
  "build": {
    "outDir": "./dist"
  }
}
