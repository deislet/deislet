{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deislet.dev/schemas/product-target-status-v1.json",
  "title": "Deislet registry-derived target status",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "generatedFrom", "standard", "backends"],
  "properties": {
    "$schema": {"const": "target-status.schema.json"},
    "schemaVersion": {"const": 1},
    "generatedFrom": {"$ref": "#/$defs/source"},
    "standard": {"$ref": "#/$defs/standard"},
    "backends": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/backend"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository", "sourceCommit", "registryPath", "registrySnapshotPath",
        "registrySha256", "registryUpdatedAt"
      ],
      "properties": {
        "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sourceCommit": {"$ref": "#/$defs/gitSha"},
        "registryPath": {"type": "string", "minLength": 1},
        "registrySnapshotPath": {"type": "string", "minLength": 1},
        "registrySha256": {"$ref": "#/$defs/sha256"},
        "registryUpdatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "releaseStatus", "normativeRelease",
        "certificationUnit", "requiredMaturity"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "releaseStatus": {"type": "string", "minLength": 1},
        "normativeRelease": {"type": "boolean"},
        "certificationUnit": {"const": "complete-standard-version"},
        "requiredMaturity": {"const": "conformance-passed"}
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "sourceCommit", "scope"],
      "properties": {
        "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sourceCommit": {"$ref": "#/$defs/gitSha"},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "note"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "format": "uri", "pattern": "^https://"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maturity", "observedAt", "outcome", "records"],
      "properties": {
        "maturity": {
          "enum": ["artifact-generated", "syntax-verified", "deployed", "conformance-passed"]
        },
        "observedAt": {"type": "string", "format": "date-time"},
        "outcome": {"enum": ["pass", "fail", "stale"]},
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceRecord"}
        }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "compliant", "supported", "validUntil", "blockers"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "compliant": {"type": "boolean"},
        "supported": {"type": "boolean"},
        "validUntil": {"type": ["string", "null"], "format": "date-time"},
        "blockers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "displayName", "role", "implementation", "evidence", "certification"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "displayName": {"type": "string", "minLength": 1},
        "role": {"enum": ["first-class", "experimental"]},
        "implementation": {"$ref": "#/$defs/implementation"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "certification": {"$ref": "#/$defs/certification"}
      },
      "allOf": [
        {
          "if": {"properties": {"certification": {"properties": {"supported": {"const": true}}}}},
          "then": {"properties": {"certification": {"properties": {"compliant": {"const": true}}}}}
        },
        {
          "if": {"properties": {"certification": {"properties": {"compliant": {"const": true}}}}},
          "then": {"properties": {"evidence": {"properties": {"maturity": {"const": "conformance-passed"}}}}}
        }
      ]
    }
  }
}
