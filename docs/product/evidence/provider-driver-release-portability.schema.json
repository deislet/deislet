{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/deislet/docs/product/evidence/provider-driver-release-portability.schema.json",
  "title": "Deislet provider driver release and installer portability evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "evidenceId",
    "collectedAt",
    "outcome",
    "scope",
    "source",
    "buildEnvironment",
    "commands",
    "requiredOperatingSystems",
    "observations",
    "priorFailedAttempts",
    "assertions",
    "limitations"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "evidenceId": {"type": "string", "minLength": 1},
    "collectedAt": {"type": "string", "format": "date-time"},
    "outcome": {"enum": ["passed", "partial", "failed"]},
    "scope": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree", "archive"],
      "properties": {
        "repository": {"const": "deislet/deislet"},
        "commit": {"$ref": "#/$defs/gitSha"},
        "tree": {"$ref": "#/$defs/gitSha"},
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "sha256", "sizeBytes"],
          "properties": {
            "format": {"const": "git-archive-tar"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "sizeBytes": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "buildEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CARGO_INCREMENTAL", "CARGO_PROFILE_TEST_DEBUG"],
      "properties": {
        "CARGO_INCREMENTAL": {"const": "0"},
        "CARGO_PROFILE_TEST_DEBUG": {"const": "0"}
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test", "clippy"],
      "properties": {
        "test": {"const": "cargo +1.96.0 test -p deis-provider-driver"},
        "clippy": {"const": "cargo +1.96.0 clippy -p deis-provider-driver --all-targets -- -D warnings"}
      }
    },
    "requiredOperatingSystems": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"const": "linux"},
        {"const": "macos"},
        {"const": "windows"}
      ],
      "items": false
    },
    "observations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/observation"}
    },
    "priorFailedAttempts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/priorFailedAttempt"}
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allRequiredOperatingSystemsPassed",
        "exactArchiveVerifiedOnEveryHost",
        "windowsReadonlyAttributeIsNotAcl",
        "noTrustedReleaseClaim",
        "noProviderConformanceClaim"
      ],
      "properties": {
        "allRequiredOperatingSystemsPassed": {"type": "boolean"},
        "exactArchiveVerifiedOnEveryHost": {"type": "boolean"},
        "windowsReadonlyAttributeIsNotAcl": {"const": true},
        "noTrustedReleaseClaim": {"const": true},
        "noProviderConformanceClaim": {"const": true}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operatingSystem": {"enum": ["linux", "macos", "windows"]},
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "exitCode"],
      "properties": {
        "outcome": {"enum": ["passed", "failed", "blocked"]},
        "exitCode": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "ignored": {"type": "integer", "minimum": 0},
        "note": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"const": "passed"}}},
          "then": {"properties": {"exitCode": {"const": 0}}}
        }
      ]
    },
    "priorCheckResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome", "exitCode"],
      "properties": {
        "id": {"enum": ["test", "clippy"]},
        "outcome": {"enum": ["passed", "failed", "not-run"]},
        "exitCode": {"type": ["integer", "null"], "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "ignored": {"type": "integer", "minimum": 0},
        "note": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"const": "passed"}}},
          "then": {"properties": {"exitCode": {"const": 0}}}
        },
        {
          "if": {"properties": {"outcome": {"const": "not-run"}}},
          "then": {"properties": {"exitCode": {"const": null}}}
        }
      ]
    },
    "priorFailedAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "archiveSha256",
        "hostAlias",
        "operatingSystem",
        "checks",
        "cause",
        "fixedBy"
      ],
      "properties": {
        "commit": {"$ref": "#/$defs/gitSha"},
        "tree": {"$ref": "#/$defs/gitSha"},
        "archiveSha256": {"$ref": "#/$defs/sha256"},
        "hostAlias": {"type": "string", "minLength": 1},
        "operatingSystem": {"const": "windows"},
        "checks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "allOf": [
                {"$ref": "#/$defs/priorCheckResult"},
                {"properties": {"id": {"const": "test"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/priorCheckResult"},
                {"properties": {"id": {"const": "clippy"}}}
              ]
            }
          ],
          "items": false
        },
        "cause": {"type": "string", "minLength": 1},
        "fixedBy": {"$ref": "#/$defs/gitSha"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hostAlias",
        "hostName",
        "operatingSystem",
        "osRelease",
        "architecture",
        "rustc",
        "cargo",
        "clippy",
        "commit",
        "archiveSha256",
        "test",
        "lint"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "hostAlias": {"type": "string", "minLength": 1},
        "hostName": {"type": "string", "minLength": 1},
        "operatingSystem": {"$ref": "#/$defs/operatingSystem"},
        "osRelease": {"type": "string", "minLength": 1},
        "kernel": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "powershell": {"type": "string", "minLength": 1},
        "rustc": {"type": "string", "minLength": 1},
        "cargo": {"type": "string", "minLength": 1},
        "clippy": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/gitSha"},
        "archiveSha256": {"$ref": "#/$defs/sha256"},
        "test": {"$ref": "#/$defs/checkResult"},
        "lint": {"$ref": "#/$defs/checkResult"}
      }
    }
  }
}
