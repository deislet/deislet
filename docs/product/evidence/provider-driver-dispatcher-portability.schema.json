            {
              "properties": {
                "command": {
                  "const": "cargo +1.96.0 test -p deis-control catalog::provider_deployment_reconciler::tests::"
                }
              }
            }
          ]
        }
      ]
    },
    "legacyTargetMigrationCommand": {
      "allOf": [
        {
          "$ref": "#/$defs/commandBase"
        },
        {
          "properties": {
            "id": {
              "const": "legacy-target-migration-test"
            },
            "command": {
              "const": "cargo +1.96.0 test -p deis-control database::schema::tests::legacy_active_provider_targets_without_a_verified_release_are_disabled -- --exact"
            }
