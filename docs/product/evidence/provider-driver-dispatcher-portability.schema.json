            "command": {
              "const": "cargo +1.96.0 clippy -p deis-provider-driver -p deis-control -p deis-queue -p deis-store -p deis-telemetry --all-targets -- -D warnings"
            }
          }
        }
      ]
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "outcome",
        "exitCode"
      ],
      "properties": {
        "id": {
          "enum": [
            "provider-driver-tests",
            "provider-driver-control-tests",
            "provider-control-tests",
            "provider-pagination-tests",
            "provider-authz-tests",
            "provider-target-grant-tests",
            "provider-release-api-tests",
            "provider-deployment-reconciler-tests",
            "legacy-target-migration-test",
            "transparency-target-migration-test",
            "provider-target-migration-tests",
            "provider-dispatch-backoff-migration-test",
            "provider-target-grant-migration-test",
            "provider-pagination-cursor-migration-test",
            "strict-clippy",
            "build-route-derivation-tests",
            "build-adapter-deislet-tests",
            "environment-declaration-tests",
            "bundle-manifest-tests",
            "cli-tests",
            "proxy-binary-for-node-tests",
            "runtime-environment-and-assets-tests"
          ]
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "ignored": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "passed"
              }
            }
          },
          "then": {
            "properties": {
              "exitCode": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "not-run"
              }
            }
          },
          "then": {
            "properties": {
              "exitCode": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hostAlias",
        "hostName",
        "operatingSystem",
        "osRelease",
        "architecture",
        "rustc",
        "cargo",
        "clippy",
        "commit",
        "archiveSha256",
        "checks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "hostAlias": {
          "type": "string",
