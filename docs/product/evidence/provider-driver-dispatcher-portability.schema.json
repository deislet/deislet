              "const": "provider-dispatch-backoff-migration-test"
            }
          },
          "oneOf": [
            {
              "properties": {
                "command": {
                  "const": "cargo +1.96.0 test -p deis-control provider_dispatch_backoff_columns_upgrade_additively_and_remain_coherent -- --nocapture"
                }
              }
            },
            {
              "properties": {
                "command": {
                  "const": "cargo +1.96.0 test -p deis-control database::schema::tests::provider_dispatch_backoff_columns_upgrade_additively_and_remain_coherent -- --exact"
                }
