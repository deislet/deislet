{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/deislet/docs/product/evidence/provider-driver-dispatcher-portability.schema.json",
  "title": "Deislet verified provider driver dispatcher portability evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "evidenceId", "collectedAt", "outcome", "scope",
    "source", "buildEnvironment", "commands", "sharedContractCheck",
    "requiredOperatingSystems", "observations", "priorFailedAttempts", "assertions",
    "limitations"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "evidenceId": {"type": "string", "minLength": 1},
    "collectedAt": {"type": "string", "format": "date-time"},
    "outcome": {"enum": ["passed", "partial", "failed"]},
    "scope": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/source"},
    "buildEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CARGO_INCREMENTAL", "CARGO_PROFILE_TEST_DEBUG"],
      "properties": {
        "CARGO_INCREMENTAL": {"const": "0"},
        "CARGO_PROFILE_TEST_DEBUG": {"const": "0"}
      }
    },
    "commands": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/driverCommand"},
        {"$ref": "#/$defs/controlCommand"},
        {"$ref": "#/$defs/migrationCommand"},
        {"$ref": "#/$defs/clippyCommand"}
      ],
      "items": false
    },
    "sharedContractCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostAlias", "command", "outcome", "exitCode", "schemas", "fixtures"],
      "properties": {
        "hostAlias": {"const": "s17"},
        "command": {"const": "python3 scripts/check-shared-contracts.py"},
        "outcome": {"const": "passed"},
        "exitCode": {"const": 0},
        "schemas": {"enum": [11, 14]},
        "fixtures": {"enum": [29, 37]}
      }
    },
    "requiredOperatingSystems": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [{"const": "linux"}, {"const": "macos"}, {"const": "windows"}],
      "items": false
    },
    "observations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/observation"}
    },
    "priorFailedAttempts": {
      "type": "array",
      "minItems": 0,
      "items": {"$ref": "#/$defs/priorFailedAttempt"}
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allRequiredOperatingSystemsPassed", "exactArchiveVerifiedOnEveryHost",
        "windowsAsyncSendRegressionClosed", "sharedProcessProtocolValidated",
        "noLiveProviderClaim", "noProviderConformanceClaim"
      ],
      "properties": {
        "allRequiredOperatingSystemsPassed": {"type": "boolean"},
        "exactArchiveVerifiedOnEveryHost": {"type": "boolean"},
        "windowsAsyncSendRegressionClosed": {"type": "boolean"},
        "sharedProcessProtocolValidated": {"const": true},
        "noLiveProviderClaim": {"const": true},
        "noProviderConformanceClaim": {"const": true},
        "signedReleaseAuthorizationValidated": {"const": true},
        "trustRootLoaderCompiledOnWindows": {"const": true}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree", "archive"],
      "properties": {
        "repository": {"const": "deislet/deislet"},
        "commit": {"$ref": "#/$defs/gitSha"},
        "tree": {"$ref": "#/$defs/gitSha"},
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "sha256", "sizeBytes"],
          "properties": {
            "format": {"const": "git-archive-tar"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "sizeBytes": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "commandBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command"],
      "properties": {"id": {"type": "string"}, "command": {"type": "string"}}
    },
    "driverCommand": {
      "allOf": [
        {"$ref": "#/$defs/commandBase"},
        {"properties": {"id": {"const": "provider-driver-tests"}, "command": {"const": "cargo +1.96.0 test -p deis-provider-driver"}}}
      ]
    },
    "controlCommand": {
      "allOf": [
        {"$ref": "#/$defs/commandBase"},
        {"properties": {"id": {"const": "provider-driver-control-tests"}, "command": {"const": "cargo +1.96.0 test -p deis-control provider_driver -- --nocapture"}}}
      ]
    },
    "migrationCommand": {
      "allOf": [
        {"$ref": "#/$defs/commandBase"},
        {"properties": {"id": {"const": "legacy-target-migration-test"}, "command": {"const": "cargo +1.96.0 test -p deis-control database::schema::tests::legacy_active_provider_targets_without_a_verified_release_are_disabled -- --exact"}}}
      ]
    },
    "clippyCommand": {
      "allOf": [
        {"$ref": "#/$defs/commandBase"},
        {"properties": {"id": {"const": "strict-clippy"}, "command": {"const": "cargo +1.96.0 clippy -p deis-provider-driver -p deis-control -p deis-queue -p deis-store -p deis-telemetry --all-targets -- -D warnings"}}}
      ]
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome", "exitCode"],
      "properties": {
        "id": {"enum": ["provider-driver-tests", "provider-driver-control-tests", "legacy-target-migration-test", "strict-clippy"]},
        "outcome": {"enum": ["passed", "failed", "not-run"]},
        "exitCode": {"type": ["integer", "null"], "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "ignored": {"type": "integer", "minimum": 0},
        "note": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"outcome": {"const": "passed"}}}, "then": {"properties": {"exitCode": {"const": 0}}}},
        {"if": {"properties": {"outcome": {"const": "not-run"}}}, "then": {"properties": {"exitCode": {"const": null}}}}
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hostAlias", "hostName", "operatingSystem", "osRelease", "architecture", "rustc", "cargo", "clippy", "commit", "archiveSha256", "checks"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "hostAlias": {"type": "string", "minLength": 1},
        "hostName": {"type": "string", "minLength": 1},
        "operatingSystem": {"enum": ["linux", "macos", "windows"]},
        "osRelease": {"type": "string", "minLength": 1},
        "kernel": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "powershell": {"type": "string", "minLength": 1},
        "rustc": {"type": "string", "minLength": 1},
        "cargo": {"type": "string", "minLength": 1},
        "clippy": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/gitSha"},
        "archiveSha256": {"$ref": "#/$defs/sha256"},
        "checks": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/checkResult"}}
      }
    },
    "priorFailedAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "hostAlias", "operatingSystem", "checks", "cause", "fixedBy"],
      "properties": {
        "source": {"$ref": "#/$defs/source"},
        "hostAlias": {"const": "s69"},
        "operatingSystem": {"const": "windows"},
        "checks": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/checkResult"}},
        "cause": {"type": "string", "minLength": 1},
        "fixedBy": {"$ref": "#/$defs/gitSha"}
      }
    }
  }
}
