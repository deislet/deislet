{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deislet/deislet/docs/product/evidence/provider-driver-dispatcher-portability.schema.json",
  "title": "Deislet verified provider driver dispatcher portability evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "evidenceId",
    "collectedAt",
    "outcome",
    "scope",
    "source",
    "buildEnvironment",
    "commands",
    "sharedContractCheck",
    "requiredOperatingSystems",
    "observations",
    "priorFailedAttempts",
    "assertions",
    "limitations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1
    },
    "collectedAt": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "passed",
        "partial",
        "failed"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "buildEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CARGO_INCREMENTAL",
        "CARGO_PROFILE_TEST_DEBUG"
      ],
      "properties": {
        "CARGO_INCREMENTAL": {
          "const": "0"
        },
        "CARGO_PROFILE_TEST_DEBUG": {
          "const": "0"
        }
      }
    },
    "commands": {
      "type": "array",
      "oneOf": [
        {
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "$ref": "#/$defs/driverCommand"
            },
            {
              "$ref": "#/$defs/controlCommand"
            },
            {
              "$ref": "#/$defs/migrationCommand"
            },
            {
              "$ref": "#/$defs/clippyCommand"
            }
          ],
          "items": false
        },
        {
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {
              "$ref": "#/$defs/driverCommand"
            },
            {
              "$ref": "#/$defs/controlCommand"
            },
            {
              "$ref": "#/$defs/reconcilerCommand"
            },
            {
              "$ref": "#/$defs/migrationCommand"
            },
            {
              "$ref": "#/$defs/clippyCommand"
            }
          ],
          "items": false
        },
        {
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {
              "$ref": "#/$defs/driverCommand"
            },
            {
              "$ref": "#/$defs/controlCommand"
            },
            {
              "$ref": "#/$defs/reconcilerCommand"
            },
            {
              "$ref": "#/$defs/migrationCommand"
            },
            {
              "$ref": "#/$defs/dispatchMigrationCommand"
            },
            {
              "$ref": "#/$defs/clippyCommand"
            }
          ],
          "items": false
        },
        {
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {
              "$ref": "#/$defs/driverCommand"
            },
            {
              "$ref": "#/$defs/controlCommand"
            },
            {
              "$ref": "#/$defs/releaseApiCommand"
            },
            {
              "$ref": "#/$defs/reconcilerCommand"
            },
            {
              "$ref": "#/$defs/migrationCommand"
            },
            {
              "$ref": "#/$defs/dispatchMigrationCommand"
            },
            {
              "$ref": "#/$defs/clippyCommand"
            }
          ],
          "items": false
        },
        {
          "minItems": 10,
          "maxItems": 10,
          "prefixItems": [
            {
              "$ref": "#/$defs/driverCommand"
            },
            {
              "$ref": "#/$defs/providerControlCommand"
            },
            {
              "$ref": "#/$defs/authzCommand"
            },
            {
              "$ref": "#/$defs/targetGrantCommand"
            },
            {
              "$ref": "#/$defs/reconcilerCommand"
            },
            {
              "$ref": "#/$defs/legacyTargetMigrationCommand"
            },
            {
              "$ref": "#/$defs/transparencyTargetMigrationCommand"
            },
            {
              "$ref": "#/$defs/dispatchMigrationCommand"
            },
            {
              "$ref": "#/$defs/targetGrantMigrationCommand"
            },
            {
              "$ref": "#/$defs/clippyCommand"
            }
          ],
          "items": false
        },
        {
          "minItems": 12,
          "maxItems": 12,
          "prefixItems": [
            {
              "$ref": "#/$defs/driverCommand"
            },
            {
              "$ref": "#/$defs/providerControlCommand"
            },
            {
              "$ref": "#/$defs/paginationControlCommand"
            },
            {
              "$ref": "#/$defs/authzCommand"
            },
            {
              "$ref": "#/$defs/targetGrantCommand"
            },
            {
              "$ref": "#/$defs/reconcilerCommand"
            },
            {
              "$ref": "#/$defs/legacyTargetMigrationCommand"
            },
            {
              "$ref": "#/$defs/transparencyTargetMigrationCommand"
            },
            {
              "$ref": "#/$defs/dispatchMigrationCommand"
            },
            {
              "$ref": "#/$defs/targetGrantMigrationCommand"
            },
            {
              "$ref": "#/$defs/paginationCursorMigrationCommand"
            },
            {
              "$ref": "#/$defs/clippyCommand"
            }
          ],
          "items": false
        },
        {
          "minItems": 19,
          "maxItems": 19,
          "prefixItems": [
            {
              "$ref": "#/$defs/driverCommand"
            },
            {
              "$ref": "#/$defs/providerControlCommand"
            },
            {
              "$ref": "#/$defs/paginationControlCommand"
            },
            {
              "$ref": "#/$defs/authzCommand"
            },
            {
              "$ref": "#/$defs/targetGrantCommand"
            },
            {
              "$ref": "#/$defs/reconcilerCommand"
            },
            {
              "$ref": "#/$defs/legacyTargetMigrationCommand"
            },
            {
              "$ref": "#/$defs/transparencyTargetMigrationCommand"
            },
            {
              "$ref": "#/$defs/dispatchMigrationCommand"
            },
            {
              "$ref": "#/$defs/targetGrantMigrationCommand"
            },
            {
              "$ref": "#/$defs/paginationCursorMigrationCommand"
            },
            {
              "$ref": "#/$defs/standardLockClippyCommand"
            },
            {
              "$ref": "#/$defs/buildRouteDerivationCommand"
            },
            {
              "$ref": "#/$defs/buildAdapterDeisletCommand"
            },
            {
              "$ref": "#/$defs/environmentDeclarationCommand"
            },
            {
              "$ref": "#/$defs/bundleManifestCommand"
            },
            {
              "$ref": "#/$defs/cliCommand"
            },
            {
              "$ref": "#/$defs/proxyBinaryCommand"
            },
            {
              "$ref": "#/$defs/runtimeEnvironmentCommand"
            }
          ],
          "items": false
        }
      ]
