    "sharedContractCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostAlias",
        "command",
        "outcome",
        "exitCode",
        "schemas",
        "fixtures"
      ],
      "properties": {
        "hostAlias": {
          "const": "s17"
        },
        "command": {
          "const": "python3 scripts/check-shared-contracts.py"
        },
        "outcome": {
          "const": "passed"
        },
        "exitCode": {
          "const": 0
        },
        "schemas": {
          "enum": [
            11,
            14,
            15,
            16,
            17,
            18
          ]
        },
        "fixtures": {
          "enum": [
            29,
            37,
            42,
            48,
            50,
            57,
            62
          ]
        }
      }
    },
    "requiredOperatingSystems": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "const": "linux"
        },
        {
          "const": "macos"
        },
        {
          "const": "windows"
        }
      ],
      "items": false
    },
    "observations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "priorFailedAttempts": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/priorFailedAttempt"
      }
    },
    "collectionObservations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/collectionObservation"
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allRequiredOperatingSystemsPassed",
        "exactArchiveVerifiedOnEveryHost",
        "windowsAsyncSendRegressionClosed",
        "sharedProcessProtocolValidated",
        "noLiveProviderClaim",
        "noProviderConformanceClaim"
      ],
      "properties": {
        "allRequiredOperatingSystemsPassed": {
          "type": "boolean"
        },
        "exactArchiveVerifiedOnEveryHost": {
          "type": "boolean"
        },
        "windowsAsyncSendRegressionClosed": {
          "type": "boolean"
        },
        "sharedProcessProtocolValidated": {
          "const": true
        },
        "noLiveProviderClaim": {
          "const": true
        },
        "noProviderConformanceClaim": {
          "const": true
        },
        "signedReleaseAuthorizationValidated": {
          "const": true
        },
        "trustRootLoaderCompiledOnWindows": {
          "const": true
        },
        "rootRotationValidated": {
          "const": true
        },
        "legacyTrustRootMigrationValidated": {
          "const": true
        },
        "transientSpawnRetryBoundaryValidated": {
          "const": true
        },
        "offlineTransparencyProofValidated": {
          "const": true
        },
        "independentWitnessThresholdValidated": {
          "const": true
        },
        "signedButUnloggedTargetMigrationValidated": {
          "const": true
        },
        "windowsServiceIdentityDaclPolicyValidated": {
          "const": true
        },
        "backgroundDispatcherLoopValidated": {
          "const": true
        },
        "retryableReceiptRecoveryValidated": {
          "const": true
        },
        "crossPageDispatchFairnessValidated": {
          "const": true
        },
        "durableSelectionBackoffValidated": {
          "const": true
        },
        "selectionBackoffMigrationValidated": {
          "const": true
        },
        "selectionBackoffRaceFenceValidated": {
          "const": true
        },
        "providerReleaseHttpInstallValidated": {
          "const": true
        },
        "providerTargetGrantValidated": {
          "const": true
        },
        "deployScopeAuthorizationValidated": {
          "const": true
        },
        "providerTargetGrantMigrationValidated": {
          "const": true
        },
        "providerListPaginationValidated": {
          "const": true
        },
        "queryBoundOpaqueCursorValidated": {
          "const": true
        },
        "exactCollectionTotalValidated": {
          "const": true
        },
        "paginationCursorMigrationValidated": {
          "const": true
        },
        "checksRanWhereTheSupportBoundaryPromisesThem": {
          "type": "boolean",
          "description": "Every check ran on the platforms ADR-018 supports the component on, and the ones outside that boundary are recorded as such rather than attempted."
        },
        "unrunChecksRecordedRatherThanReportedAsPassed": {
          "type": "boolean",
          "description": "A check a host could not run is recorded with the reason it could not run; it is never folded into a pass."
        },
        "caseInsensitiveFilesystemRuleProvenWithoutOne": {
          "type": "boolean",
          "description": "The installed-tree path collision rule is proven by a value-level test, so a filesystem that folds case cannot hide it."
        },
        "buildOutputPathHasOneSpelling": {
          "type": "boolean",
          "description": "A build reports its output directory and records its current selection under one spelling, verified through a symlink the test creates."
        },
        "cliCompilesUnderStrictLintOnWindows": {
          "type": "boolean",
          "description": "The official CLI passes clippy with warnings denied when compiled for Windows."
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree",
        "archive"
      ],
      "properties": {
        "repository": {
          "const": "deislet/deislet"
        },
        "commit": {
          "$ref": "#/$defs/gitSha"
        },
        "tree": {
          "$ref": "#/$defs/gitSha"
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "sha256",
            "sizeBytes"
          ],
          "properties": {
            "format": {
              "const": "git-archive-tar"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "commandBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      }
    },
    "driverCommand": {
      "allOf": [
        {
          "$ref": "#/$defs/commandBase"
        },
        {
          "properties": {
            "id": {
              "const": "provider-driver-tests"
            },
            "command": {
              "const": "cargo +1.96.0 test -p deis-provider-driver"
            }
          }
        }
      ]
    },
    "controlCommand": {
      "allOf": [
        {
          "$ref": "#/$defs/commandBase"
        },
        {
          "properties": {
