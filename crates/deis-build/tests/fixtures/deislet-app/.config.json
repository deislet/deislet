{
  "version": "1.0.0",
  "name": "fixture-app",
  "runtime": "standard-v1",
  "language": "typescript",
  "functionRoot": "./functions",
  "environment": {
    "declarations": [
      {
        "name": "API_KEY",
        "kind": "secret",
        "valueType": "string",
        "required": true
      },
      {
        "name": "LOG_LEVEL",
        "kind": "config",
        "valueType": "string",
        "required": true
      }
    ],
    "values": {
      "LOG_LEVEL": "info"
    }
  },
  "services": {
    "kv": {
      "enabled": true
    },
    "database": {
      "enabled": true
    }
  },
  "cron": [
    "0 */6 * * *"
  ],
  "queues": [
    {
      "name": "jobs",
      "batchSize": 10
    }
  ],
  "assets": {
    "dir": "./public"
  },
  "vendors": {
    "deislet": {
      "enabled": true
    }
  },
  "build": {
    "outDir": "./dist"
  }
}
