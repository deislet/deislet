{
  "version": "1.0.0",
  "name": "fixture-app",
  "runtime": "standard-v1",
  "language": "typescript",
  "functionRoot": "./functions",
  "environment": {
    "variables": { "LOG_LEVEL": "info" },
    "secrets": ["API_KEY"]
  },
  "services": {
    "kv": { "enabled": true },
    "database": { "enabled": true }
  },
  "cron": ["0 */6 * * *"],
  "queues": [{ "name": "jobs", "batchSize": 10 }],
  "assets": { "dir": "./public" },
  "vendors": {
    "deislet": { "enabled": true }
  },
  "build": {
    "outDir": "./dist"
  }
}
