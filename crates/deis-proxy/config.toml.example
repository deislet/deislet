# Proxy configuration
#
# Layering: baseline defaults + this file + control overlay. Every key is
# optional; an unset key keeps the baseline value shown here.
# Order matters, and TOML is the reason: once a table header like
# `[[upstreams]]` or `[health_check]` appears, every bare key after it belongs
# to *that* table, and this proxy refuses unknown fields. So every top-level
# key is written first and the tables come afterwards. Moving one of the keys
# below down past a table turns it into an unknown field of that table and the
# configuration stops loading, which is why
# `config::tests::the_shipped_example_configuration_loads` reads this file.

# Relative paths anywhere in this file (database, pid_file, upgrade_sock,
# log paths, certificate files) are resolved against the directory deis-proxy was
# started from, including across `-s reload`, which starts the replacement
# from that same directory.

# Run in the background and write pid_file. Also enabled by `-d`.
daemon = false
# Identity to switch to in daemon mode. Pingora switches identity inside
# daemonize(), before any listener is bound, so leave these unset unless every
# listen/tls port is bindable by that user (see net.ipv4.ip_unprivileged_port_start)
# and deis-proxy is started as root. To run unprivileged, leave them unset and let
# the service manager drop privileges (systemd User= plus
# AmbientCapabilities=CAP_NET_BIND_SERVICE); file capabilities do not survive
# the identity switch.
# user = "nobody"
# group = "nogroup"
pid_file = "/tmp/deis-proxy.pid"
# Unix socket used to hand listening sockets to a replacement process during
# a zero-downtime upgrade (`deis-proxy -s reload`).
upgrade_sock = "/tmp/deis_proxy_upgrade.sock"
# Proxy worker threads. Default: number of CPUs.
# worker_threads = 8
# SQLite database holding the application list pushed by the control.
database = "sites.db"

# Plain HTTP listeners: every address combined with every port.
listen_addr = ["0.0.0.0"]
listen_ports = [80]

# round_robin | random | ip_hash | header_hash(<Header-Name>)
# Fixed for the lifetime of the process; the upstream list is not.
balancing_strategy = "round_robin"
# Seconds between health checks and upstream list refreshes.
health_check_interval_secs = 5
# Seconds to wait for one upstream connection. A request whose connection is
# refused or times out is retried on another upstream, up to three upstreams,
# so this is also the worst-case cost of each of those attempts.
upstream_connect_timeout_secs = 5
upstream_read_timeout_secs = 30

# On shutdown or upgrade: seconds to keep serving in-flight requests after new
# connections are no longer accepted, then seconds allowed for the workers to
# wind down. Together they bound how long the old process lingers.
grace_period_secs = 10
graceful_shutdown_timeout_secs = 5

# TLS listeners. The baseline has none; enable this table to terminate TLS.
# Certificates belong to applications and are chosen by the SNI name the
# client sends; default_certificate serves names no application claims.
# Without any certificate, TLS handshakes are rejected.
# [tls]
# ports = [443]
# default_certificate = { cert_file = "/etc/deis-proxy/default.pem", key_file = "/etc/deis-proxy/default.key" }

# Automatic certificates over ACME (RFC 8555). Off unless enabled is true; an
# instance with its own certificate files needs none of this and never
# contacts a certificate authority.
#
# What turning it on needs:
#   - port 80 reachable from the internet at every name being certified. The
#     authority fetches http://<name>/.well-known/acme-challenge/<token> there
#     and follows no other port; this proxy answers it itself, so there is no
#     webroot to share and nothing else to run. Put 80 in listen_ports, or
#     forward it here.
#   - tls.ports above, or the certificates could never be served.
#   - an email address. It is where the authority writes when a certificate is
#     close to expiring and renewal has been failing, which is the one warning
#     that arrives before an outage.
#   - terms_of_service_agreed = true. RFC 8555 registration carries an
#     agreement to the authority's terms; this process will not agree to them
#     on your behalf.
#
# What it certifies: the domains of the applications the control pushes, plus
# the exact hosts in the catalog's routing table. Nothing is listed here - a
# domain added through the control plane gets a certificate with no edit on
# this machine. A name you have already named a certificate file for stays
# yours. Wildcards are not certified: RFC 8555 issues those only against the
# dns-01 challenge, which this implementation does not speak.
#
# [tls.acme]
# enabled = true
# Default: Let's Encrypt staging, which issues from a root no browser trusts.
# That is the right place to start. Change it to
# https://acme-v02.api.letsencrypt.org/directory only once a name has been
# issued successfully here: production's limits are counted per registered
# domain per week and cannot be given back.
# directory_url = "https://acme-staging-v02.api.letsencrypt.org/directory"
# contact_email = "ops@example.com"
# terms_of_service_agreed = true
# The account key and every issued certificate, kept across restarts. Split by
# authority inside, so moving from staging to production obtains everything
# again rather than leaving untrusted certificates in place.
# storage_dir = "acme"
# Renew once fewer than this many days of validity remain (default 30 on a
# 90 day certificate), and log a failed renewal at error rather than warn once
# fewer than alarm_before_days remain (default 7).
# renew_before_days = 30
# alarm_before_days = 7
# Seconds between renewal passes (default 12 hours), and the retry backoff
# after a failure: the first wait, doubled each time, up to the ceiling.
# check_interval_secs = 43200
# retry_backoff_secs = 60
# max_retry_backoff_secs = 21600
# Ceiling on how many names this instance will ever hold certificates for. A
# route table that suddenly grew must not become an order per name: exhausting
# the authority's weekly limit stops issuance for every name under the domain,
# production included.
# max_names = 20
# Whether the automatic per-environment addresses under routing.preview_zone
# get certificates of their own. Off by default: preview environments come and
# go with branches and each one would spend one of those weekly certificates.
# One wildcard for the zone covers them all and costs one - but a wildcard
# needs dns-01. Turn this on for a handful of long-lived environments; place a
# wildcard by hand for a zone that churns.
# include_preview_addresses = false

[https]
# Redirect plain HTTP to HTTPS for applications that have a certificate.
auto_redirect_to_https = true
# Terminate TLS here and speak plain HTTP to upstreams. With false the
# upstream leg is TLS too, using the client's Host as SNI: every upstream
# port must then serve TLS with a certificate valid for that name.
auto_offload_https = true

# Backends shared by all applications. Hostnames are resolved on every
# refresh; each resolved address becomes a backend.
#
# ADDING A SECOND MACHINE TAKES TWO STEPS, AND THIS IS THE SECOND ONE.
# A deis-runtime node that registers itself with the control plane does not
# become an upstream of any proxy. Registration tells deis-control how to
# *manage* the node - it reports its management gRPC address, not the port
# traffic arrives on - and no edge is told anything. So a new machine is
# managed, healthy and deployed to while taking no traffic at all, until its
# data address is listed below in the configuration of every proxy that should
# send it requests and each of those is reloaded (`deis-proxy -s reload`).
# The list here is the only source of upstreams there is; deis-proxy logs it
# at startup for the same reason this paragraph exists.
[[upstreams]]
host = "127.0.0.1"
port = 8001
weight = 1

[[upstreams]]
host = "127.0.0.1"
port = 8002
weight = 2

# What the edge asks an upstream before giving it traffic.
[health_check]
# A newly discovered address receives no client request until one probe has
# passed. These thresholds apply after that first proof, so failure hysteresis
# cannot accidentally admit an unknown node during startup or live discovery.
# http (default) asks the node; tcp only opens a connection, which a
# deis-runtime node accepts long before it can serve anything.
mode = "http"
path = "/health"
app_id = "_system"
timeout_secs = 2
healthy_after = 1
unhealthy_after = 2
# How much the node's own `x-deis-node-readiness` answer is believed.
#
#   reported (default) - `starting` is out of rotation; `degraded` keeps its
#                        share, because every node reports degraded at once
#                        when the control plane goes down and evicting them
#                        all would answer 503 to traffic they can still
#                        serve; a node that states nothing is judged on the
#                        200 alone.
#   required           - only a node stating `ready` is given traffic. A node
#                        that states nothing is out of rotation, so this
#                        empties the pool against a fleet that predates the
#                        header.
#   ignored            - the status code alone decides. For an upstream that
#                        is not a deis-runtime node.
#
# Why a node is degraded is the node's to say, in `x-deis-node-reason` beside
# the readiness. deis-proxy repeats that header and never guesses in its
# place: a node that sends none is logged as one that did not say. `degraded`
# has several causes - a control plane nobody can reach, a bundle that would
# not load, an environment that would not stop - and a log line that names the
# wrong one sends you to the component that is working.
readiness = "reported"

[compression]
enabled = true
algo = "gzip"   # gzip | br | zstd
level = 6       # 1 (fastest) to 9 (smallest)

[log.error_log]
level = "info"  # trace | debug | info | warn | error; RUST_LOG overrides
# Default: stderr. Set a path in daemon mode: pingora detaches stderr when it
# daemonizes, so without one nothing logged after startup is visible.
# path = "/var/log/deis-proxy/error.log"

# One line per request. Available fields:
#   remote_addr user_agent referer time_local host app_id method uri protocol
#   status body_bytes_sent request_time upstream_addr ssl_protocol ssl_cipher
# [log.access_log]
# path = "/var/log/deis-proxy/access.log"
# format = "$time_local $remote_addr $host $app_id $method $uri $status $request_time $upstream_addr"

# Control (deis-control). Omit this table to run standalone.
#
# `secret` is one of the control plane's node_preshared_keys. It is the
# credential for both directions of the relationship: the gRPC channel this
# instance registers on, and the HTTP read of the routing table below.
# Configuring this changes what an unroutable request means. Left commented
# out, this instance is standalone: with no applications of its own it is a
# plain reverse proxy and forwards everything, having stripped x-deis-app-id
# and x-deis-environment from it first, since it decided neither. Set, it is
# driven from the control plane - and until a routing table has been fetched
# even once it answers 503 rather than forwarding a request it cannot place.
# A poll that fails after one succeeded is not that case: the last table
# stays in force and traffic is unaffected.
# [control]
# addr = "http://127.0.0.1:8085"
# associated_id = "deis-proxy-01"
# secret = "<64 hex characters>"
# heartbeat_interval = 30

# The catalog's routing table: which application a request belongs to.
#
# This instance reads GET /api/routing-table from the control plane every
# control_poll_interval_secs seconds and swaps the whole table in at once. A
# route created through the control plane API or the dashboard takes effect
# within one interval, with no restart and no reload.
#
# When the control plane is unreachable the last table this process accepted
# stays in force indefinitely: traffic keeps being served exactly as it was,
# and the only thing lost is the ability to change routing. Each failed poll
# logs at ERROR saying which table is still routing and how old it is.
#
# Needs [control] above. Without it there is no table to fetch and only the
# applications configured on this machine are routed.
# [routing]
# control_poll_interval_secs = 5
# Ceiling on the fetched table, in bytes (default 8 MiB, roughly one line of
# JSON per route). A table larger than this is refused whole and the previous
# one stays in force.
# max_table_bytes = 8388608
# Automatic per-environment addresses. Unset - the default - turns them off
# entirely; only routes an operator created exist.
#
# With a zone set, every environment of every application is reachable at
#     <env>--<app>.<zone>
# and the default environment (production) also at
#     <app>.<zone>
# so environment `pr-42` of app `shop` under `preview.example.com` answers at
# pr-42--shop.preview.example.com.
#
# One DNS label rather than two (`pr-42.shop.<zone>`) on purpose: a wildcard
# certificate matches exactly one label, so `*.preview.example.com` covers
# every application and environment at once. The two-label form would need a
# new `*.shop.preview.example.com` certificate for every application created.
#
# Point a wildcard DNS record at this instance and give it a certificate for
# the zone - tls.default_certificate above is the usual place - or these
# names resolve to nothing and the TLS handshake fails. An explicit route in
# the catalog always wins over the automatic address for the same name.
# preview_zone = "preview.example.com"

# [cache] is parsed and validated but not applied to traffic yet; leave it out.
